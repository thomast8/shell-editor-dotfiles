// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "none"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "play_sound_when_agent_done": true,
    "model_parameters": []
  },
  "disable_ai": true,
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_from_file_finder": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_name": true,
    "show_branch_icon": false
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "context7_api_key": "ctx7sk-32a98822-fa0d-4ac2-954a-e4d2a62876e7"
      }
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "terminal": {
    "dock": "right",
    "font_size": 14.0,
    "blinking": "on",
    "option_as_meta": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_fallbacks": [
    "Menlo",
    "monospace"
  ],
  "buffer_font_family": "JetBrains Mono",
  "soft_wrap": "editor_width",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Solarized Light",
    "dark": "Solarized Dark",
  },
}
